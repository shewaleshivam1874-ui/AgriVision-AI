# AgriVision AI Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=agrivision_ai_secure_secret_key_2026

# Google Gemini AI Vision API Key
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MySQL Database Configuration

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agrivision_db

# Storage Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=10485760 # 10 MB limit
